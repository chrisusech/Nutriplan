    .cover {
      background: #2E7D32; color: #fff; border-radius: 22px;
      padding: 30px 30px 26px; margin-bottom: 20px;
    }
    .cover .trainer { font-size: 11pt; font-weight: 700; opacity: .9; margin-bottom: 18px; }
    .cover .kicker {
      font-size: 8.5pt; font-weight: 600; letter-spacing: .5px;
      text-transform: uppercase; opacity: .85; margin-bottom: 4px;
    }
    .cover h1 { font-size: 24pt; font-weight: 800; margin: 0 0 4px; letter-spacing: -.5px; }
    .cover .sub { font-size: 11pt; opacity: .92; margin: 0 0 18px; }
    .cover .macros { display: flex; gap: 8px; }
    .cover .chip {
      background: rgba(255,255,255,.16); border-radius: 12px;
      padding: 9px 13px; min-width: 92px;
    }
    .cover .chip .lbl { font-size: 8pt; opacity: .85; }
    .cover .chip .val { font-size: 14pt; font-weight: 800; }
  
    .day {
      border: 1px solid #F1E4DD; border-radius: 18px; overflow: hidden;
      margin-bottom: 14px; break-inside: avoid;
    }
    .day .head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px;
    }
    .day .head.alt { background: #eaf2ea; }
    .day .head.plain { background: #FBF7F4; }
    .day .badge {
      display: inline-block; width: 30px; height: 30px; line-height: 30px;
      text-align: center; border-radius: 10px; background: #2E7D32;
      color: #fff; font-weight: 800; font-size: 11pt; margin-right: 10px;
    }
    .day .name { font-size: 12pt; font-weight: 800; }
    .day .totals { font-size: 8.5pt; color: #8A756C; }
    .day .headwrap { display: flex; align-items: center; }
    .meals { padding: 4px 16px 8px; }
    .meal { padding: 9px 0; border-bottom: 1px solid #F6ECE7; }
    .meal:last-child { border-bottom: none; }
    .meal .top {
      display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 5px;
    }
    .meal .nm { font-size: 10pt; font-weight: 700; }
    .meal .meta { font-size: 8pt; color: #B0968C; }
    .meal .items { }
    .meal .it {
