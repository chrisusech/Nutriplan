      background: #FBF7F4; border: 1px solid #F1E4DD;
      padding: 3px 9px; border-radius: 999px; margin: 0 4px 4px 0;
    }
    .meal .it.free { background: #eaf2ea; border-color: #eaf2ea; }
  
    .note {
      background: #FBF7F4; border: 1px solid #F1E4DD; border-radius: 16px;
      padding: 14px 18px; margin-top: 6px; break-inside: avoid;
    }
    .note h3 { font-size: 10.5pt; margin: 0 0 8px; color: #3B2E2B; }
    .note ol { margin: 0; padding-left: 18px; }
    .note li { font-size: 8.5pt; color: #6B564E; margin-bottom: 3px; }
    .foot { margin-top: 12px; font-size: 6.5pt; color: #B0968C; text-align: center; }
