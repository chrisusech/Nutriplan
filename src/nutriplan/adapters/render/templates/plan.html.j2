<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
  @page {
    size: A4 landscape;
    margin: 12mm 10mm;
    @bottom-center {
      content: "{{ branding.tenant_name }}{% if branding.handle %} · {{ branding.handle }}{% endif %} — página " counter(page) " de " counter(pages);
      font-size: 7.5pt;
      color: #888;
    }
  }
  * { box-sizing: border-box; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #222; font-size: 8.5pt; margin: 0; }
  header { display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid {{ branding.primary_color }}; padding-bottom: 6px; margin-bottom: 10px; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { height: 42px; }
  .brand .name { font-size: 15pt; font-weight: 700; color: {{ branding.primary_color }}; }
  .brand .handle { font-size: 8pt; color: #666; }
  .title { text-align: right; }
  .title h1 { margin: 0; font-size: 13pt; }
  .title .phase { color: {{ branding.accent_color }}; font-weight: 700; font-size: 10pt; }
  .targets { margin: 6px 0 8px; }
  .targets span { display: inline-block; background: {{ branding.primary_color }}14; border: 1px solid {{ branding.primary_color }}55;
                  border-radius: 4px; padding: 2px 8px; margin-right: 6px; font-size: 8pt; }
  table.plan { width: 100%; border-collapse: collapse; table-layout: fixed; }
  table.plan th, table.plan td { border: 1px solid #ccc; padding: 4px 5px; vertical-align: top; }
  table.plan thead th { background: {{ branding.primary_color }}; color: white; font-size: 8.5pt; padding: 5px; }
  table.plan th.slot { width: 9%; background: {{ branding.primary_color }}0f; color: {{ branding.primary_color }};
                       text-transform: uppercase; font-size: 7.5pt; letter-spacing: .4px; text-align: left; }
  ul.portions { margin: 0; padding-left: 11px; }
  ul.portions li { margin-bottom: 2px; }
  .extra { color: {{ branding.accent_color }}; font-weight: 600; font-size: 7.5pt; }
  .kcal { color: #999; font-size: 7pt; text-align: right; margin-top: 2px; }
  section.notes { margin-top: 10px; page-break-inside: avoid; }
  section.notes h2 { font-size: 10pt; color: {{ branding.primary_color }}; border-bottom: 1px solid {{ branding.primary_color }}55; padding-bottom: 2px; }
  section.notes ol { margin: 4px 0 0; padding-left: 16px; }
  section.notes li { margin-bottom: 2px; }
  .provenance { margin-top: 8px; font-size: 6.5pt; color: #aaa; }
</style>
</head>
<body>
<header>
  <div class="brand">
    {% if branding.logo_path %}<img src="{{ branding.logo_path }}" alt="logo">{% endif %}
    <div>
      <div class="name">{{ branding.tenant_name }}</div>
      {% if branding.handle %}<div class="handle">{{ branding.handle }}</div>{% endif %}
    </div>
  </div>
  <div class="title">
    <h1>Plan nutricional{% if client_name %} — {{ client_name }}{% endif %}</h1>
    <div class="phase">{{ phase_label }}</div>
  </div>
</header>

<div class="targets">
  <span><strong>{{ "%.0f"|format(daily.kcal) }}</strong> kcal/día</span>
  <span>Proteína <strong>{{ "%.0f"|format(daily.protein_g) }} g</strong></span>
  <span>Carbohidratos <strong>{{ "%.0f"|format(daily.carb_g) }} g</strong></span>
  <span>Grasas <strong>{{ "%.0f"|format(daily.fat_g) }} g</strong></span>
</div>

<table class="plan">
  <thead>
    <tr>
      <th class="slot"></th>
      {% for day in day_labels %}<th>{{ day }}</th>{% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for slot, cells in grid.items() %}
    <tr>
      <th class="slot">{{ slot_labels[slot] }}</th>
      {% for cell in cells %}
      <td>
        <ul class="portions">
          {% for p in cell.portions %}<li>{{ p.text }}</li>{% endfor %}
        </ul>
        {% for extra in cell.extras %}<div class="extra">{{ extra }}</div>{% endfor %}
        {% if cell.kcal %}<div class="kcal">{{ "%.0f"|format(cell.kcal) }} kcal</div>{% endif %}
      </td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
</table>

<section class="notes">
  <h2>Anotaciones Importantes</h2>
  <ol>
    {% for nota in anotaciones %}<li>{{ nota }}</li>{% endfor %}
  </ol>
</section>

<div class="provenance">
  Config {{ plan.config_version }} · Prompt {{ plan.prompt_version }} · Modelo {{ plan.model }} · Hash {{ plan.input_hash[:12] }}
</div>
</body>
</html>
