<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
  @page { size: letter; margin: 1.5cm 1.4cm; }
  * { box-sizing: border-box; }
  body {
    font-family: "Poppins", "Helvetica Neue", Arial, sans-serif;
    color: #3B2E2B; margin: 0; font-size: 10pt; line-height: 1.4;
  }
  .cover {
    background: {{ brand }}; color: #fff; border-radius: 22px;
    padding: 30px 30px 26px; margin-bottom: 20px;
  }
  .cover .trainer { font-size: 11pt; font-weight: 700; opacity: .9; margin-bottom: 18px; }
  .cover .kicker {
    font-size: 8.5pt; font-weight: 600; letter-spacing: .5px;
    text-transform: uppercase; opacity: .85; margin-bottom: 4px;
  }
  .cover h1 { font-size: 24pt; font-weight: 800; margin: 0 0 4px; letter-spacing: -.5px; }
  .cover .sub { font-size: 11pt; opacity: .92; margin: 0 0 18px; }
  .cover .macros { display: flex; gap: 8px; }
  .cover .chip {
    background: rgba(255,255,255,.16); border-radius: 12px;
    padding: 9px 13px; min-width: 92px;
  }
  .cover .chip .lbl { font-size: 8pt; opacity: .85; }
  .cover .chip .val { font-size: 14pt; font-weight: 800; }

  .day {
    border: 1px solid #F1E4DD; border-radius: 18px; overflow: hidden;
    margin-bottom: 14px; break-inside: avoid;
  }
  .day .head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px;
  }
  .day .head.alt { background: {{ brand_soft }}; }
  .day .head.plain { background: #FBF7F4; }
  .day .badge {
    display: inline-block; width: 30px; height: 30px; line-height: 30px;
    text-align: center; border-radius: 10px; background: {{ brand }};
    color: #fff; font-weight: 800; font-size: 11pt; margin-right: 10px;
  }
  .day .name { font-size: 12pt; font-weight: 800; }
  .day .totals { font-size: 8.5pt; color: #8A756C; }
  .day .headwrap { display: flex; align-items: center; }
  .meals { padding: 4px 16px 8px; }
  .meal { padding: 9px 0; border-bottom: 1px solid #F6ECE7; }
  .meal:last-child { border-bottom: none; }
  .meal .top {
    display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 5px;
  }
  .meal .nm { font-size: 10pt; font-weight: 700; }
  .meal .meta { font-size: 8pt; color: #B0968C; }
  .meal .items { }
  .meal .it {
    display: inline-block; font-size: 8.5pt; color: #5C4A44;
    background: #FBF7F4; border: 1px solid #F1E4DD;
    padding: 3px 9px; border-radius: 999px; margin: 0 4px 4px 0;
  }
  .meal .it.free { background: {{ brand_soft }}; border-color: {{ brand_soft }}; }

  .note {
    background: #FBF7F4; border: 1px solid #F1E4DD; border-radius: 16px;
    padding: 14px 18px; margin-top: 6px; break-inside: avoid;
  }
  .note h3 { font-size: 10.5pt; margin: 0 0 8px; color: #3B2E2B; }
  .note ol { margin: 0; padding-left: 18px; }
  .note li { font-size: 8.5pt; color: #6B564E; margin-bottom: 3px; }
  .foot { margin-top: 12px; font-size: 6.5pt; color: #B0968C; text-align: center; }
</style>
</head>
<body>
  <div class="cover">
    {% if branding.tenant_name %}<div class="trainer">{{ branding.tenant_name }}</div>{% endif %}
    <div class="kicker">Plan nutricional semanal</div>
    <h1>{{ client_name }}</h1>
    <p class="sub">7 días · {{ "%.0f"|format(daily.kcal) }} kcal diarias</p>
    <div class="macros">
      <div class="chip"><div class="lbl">Calorías</div><div class="val">{{ "%.0f"|format(daily.kcal) }}</div></div>
      <div class="chip"><div class="lbl">Proteína</div><div class="val">{{ "%.0f"|format(daily.protein_g) }} g</div></div>
      <div class="chip"><div class="lbl">Carbos</div><div class="val">{{ "%.0f"|format(daily.carb_g) }} g</div></div>
      <div class="chip"><div class="lbl">Grasas</div><div class="val">{{ "%.0f"|format(daily.fat_g) }} g</div></div>
    </div>
  </div>

  {% for day in week %}
  <div class="day">
    <div class="head {{ 'alt' if loop.index0 % 2 == 0 else 'plain' }}">
      <div class="headwrap">
        <span class="badge">{{ day.n }}</span>
        <div>
          <div class="name">{{ day.name }}</div>
          <div class="totals">{{ day.kcal }} kcal · P {{ day.protein_g }}g · C {{ day.carb_g }}g · G {{ day.fat_g }}g</div>
        </div>
      </div>
    </div>
    <div class="meals">
      {% for ml in day.meals %}
      <div class="meal">
        <div class="top">
          <span class="nm">{{ ml.slot_label }}</span>
          <span class="meta">{{ ml.time }} · {{ ml.kcal }} kcal</span>
        </div>
        <div class="items">
          {% for it in ml.items %}
          <span class="it{{ ' free' if 'libre' in it else '' }}">{{ it }}</span>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endfor %}

  <div class="note">
    <h3>Anotaciones importantes</h3>
    <ol>
      {% for nota in anotaciones %}<li>{{ nota }}</li>{% endfor %}
    </ol>
  </div>

  <div class="foot">
    Config {{ plan.config_version }} · Prompt {{ plan.prompt_version }} ·
    Modelo {{ plan.model }} · Hash {{ plan.input_hash[:12] }}
  </div>
</body>
</html>
