<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
{# El único CSS inline: los colores derivados de la marca del tenant. El resto
   vive en pdf.css, que el renderer pasa como stylesheet. #}
<style>
  :root {
    --brand: {{ brand }};
    --brand-soft: {{ brand_soft }};
    --brand-tint: {{ brand_tint }};
    --brand-wash: {{ brand_wash }};
  }
</style>
</head>
<body>

  {# --- Página 1: anotaciones + objetivo diario --- #}
  <section class="notes-page">
    <h1 class="notes-title">Anotaciones Importantes</h1>

    <p class="notes-client">
      Plan de <strong>{{ client_name }}</strong>{% if branding.tenant_name %} ·
      {{ branding.tenant_name }}{% endif %}{% if duration_note %} · {{ duration_note }}{% endif %}
    </p>

    <ul class="notes-list">
      {% for nota in anotaciones %}
      <li>{{ nota }}</li>
      {% endfor %}
    </ul>

    <div class="targets">
      <h2>Tu objetivo diario</h2>
      <div class="tiles">
        {% for t in target_tiles %}
        <div class="tile" style="background: {{ t.soft }}; color: {{ t.color }}">
          <span class="val">{{ t.value }}</span>
          <span class="lbl">{{ t.label }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# --- Una página por fase (15 días = 1 rejilla; 30 días = 2) --- #}
  {% for section in sections %}
  <section class="phase-page">
    <div class="banner">
      {% if branding.tenant_name %}<span class="kicker">{{ branding.tenant_name }}</span>{% endif %}
      <h1>Plan Nutricional</h1>
    </div>

    <p class="intro">{{ section.intro }}</p>

    <table class="grid">
      <thead>
        <tr>
          <th class="corner"></th>
          {% for day in section.days %}<th class="day">{{ day }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in section.rows %}
        <tr>
          <th class="slot">{{ row.label }}<span class="time">{{ row.time }}</span></th>
          {% for cell in row.cells %}
          <td>
            {% for p in cell.portions %}<span class="portion">{{ p.text }}</span>{% endfor %}
            {% for e in cell.extras %}<span class="extra">{{ e }}</span>{% endfor %}
            {% if cell.macro_line %}<span class="macros">{{ cell.macro_line }}</span>{% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
        <tr class="day-totals">
          <th class="slot">Totales día</th>
          {% for dt in section.day_totals %}
          <td>
            <span class="total-kcal">{{ dt.kcal }} kcal</span>
            <span class="total-macros">P {{ dt.protein_g }} · C {{ dt.carb_g }} · G {{ dt.fat_g }}</span>
          </td>
          {% endfor %}
        </tr>
      </tbody>
    </table>

    <div class="brandmark">
      {% if logo_data_uri %}<img class="logo" src="{{ logo_data_uri }}" alt="">{% endif %}
      {% if branding.tenant_name %}<span class="name">{{ branding.tenant_name }}</span>{% endif %}
      {% if branding.handle %}<span class="handle">@{{ branding.handle.lstrip('@') }}</span>{% endif %}
    </div>
  </section>
  {% endfor %}

</body>
</html>
