<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
  @page { size: letter landscape; margin: 1.2cm 1cm; }
  * { box-sizing: border-box; }
  body {
    font-family: "Poppins", "Helvetica Neue", Arial, sans-serif;
    color: #3B2E2B; margin: 0; font-size: 8.5pt; line-height: 1.35;
  }
  .cover {
    background: {{ brand }}; color: #fff; border-radius: 16px;
    padding: 22px 24px 18px; margin-bottom: 14px;
  }
  .cover h1 { font-size: 20pt; font-weight: 800; margin: 0 0 4px; }
  .cover .sub { font-size: 10pt; opacity: .92; margin: 0; }
  .phase-title {
    font-size: 11pt; font-weight: 800; margin: 16px 0 8px; color: #3B2E2B;
  }
  .phase-block { page-break-inside: avoid; margin-bottom: 18px; }
  table.grid {
    width: 100%; border-collapse: collapse; margin-bottom: 12px;
  }
  table.grid th, table.grid td {
    border: 1px solid #E8D8CF; vertical-align: top; padding: 5px 6px;
  }
  table.grid th {
    background: {{ brand_soft }}; font-weight: 700; font-size: 8pt;
    text-align: center;
  }
  table.grid th.slot {
    text-align: left; width: 72px; background: #FBF7F4;
  }
  .portion { display: block; margin-bottom: 2px; font-size: 7.5pt; }
  .extra { display: block; font-size: 7pt; color: #8A756C; font-style: italic; }
  .macros {
    display: block; font-size: 6.5pt; font-weight: 700; color: #6B564E;
    margin-top: 3px; padding-top: 2px; border-top: 1px solid #F1E4DD;
  }
  tr.day-totals th, tr.day-totals td {
    background: #FBF7F4; font-weight: 700;
  }
  tr.day-totals td { font-size: 7pt; }
  .day-macro-kcal { display: block; font-size: 7.5pt; color: #3B2E2B; }
  .day-macro-pcg { display: block; font-size: 6.5pt; color: #8A756C; margin-top: 1px; }
  .note {
    background: #FBF7F4; border: 1px solid #F1E4DD; border-radius: 12px;
    padding: 12px 16px; margin-top: 8px; break-inside: avoid;
  }
  .note h3 { font-size: 10pt; margin: 0 0 6px; }
  .note ol { margin: 0; padding-left: 16px; }
  .note li { font-size: 8pt; color: #6B564E; margin-bottom: 2px; }
</style>
</head>
<body>
  <div class="cover">
    {% if branding.tenant_name %}<div style="font-size:9pt;font-weight:700;opacity:.9;margin-bottom:10px">{{ branding.tenant_name }}</div>{% endif %}
    <h1>{{ client_name }}</h1>
    <p class="sub">Objetivo diario · {{ macro_subtitle }}</p>
  </div>

  {% for section in sections %}
  <div class="phase-block">
    {% if section.title %}<div class="phase-title">{{ section.title }}</div>{% endif %}
    <table class="grid">
      <thead>
        <tr>
          <th class="slot"></th>
          {% for day in section.days %}<th>{{ day }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in section.rows %}
        <tr>
          <th class="slot">{{ row.label }}</th>
          {% for cell in row.cells %}
          <td>
            {% for p in cell.portions %}<span class="portion">{{ p.text }}</span>{% endfor %}
            {% for e in cell.extras %}<span class="extra">{{ e }}</span>{% endfor %}
            {% if cell.macro_line %}
            <span class="macros">{{ cell.macro_line }}</span>
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
        <tr class="day-totals">
          <th class="slot">Totales día</th>
          {% for dt in section.day_totals %}
          <td>
            <span class="day-macro-kcal">{{ dt.kcal }} kcal</span>
            <span class="day-macro-pcg">P {{ dt.protein_g }} g · C {{ dt.carb_g }} g · G {{ dt.fat_g }} g</span>
          </td>
          {% endfor %}
        </tr>
      </tbody>
    </table>
  </div>
  {% endfor %}

  <div class="note">
    <h3>Anotaciones importantes</h3>
    <ol>
      {% for nota in anotaciones %}<li>{{ nota }}</li>{% endfor %}
    </ol>
  </div>
</body>
</html>
