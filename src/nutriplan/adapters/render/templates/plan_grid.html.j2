<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
{# El único CSS inline: los colores derivados de la marca del tenant. El resto
   vive en pdf.css, que el renderer pasa como stylesheet. #}
<style>
  :root {
    --brand: {{ brand }};
    --brand-soft: {{ brand_soft }};
    --brand-tint: {{ brand_tint }};
    --brand-wash: {{ brand_wash }};
  }
</style>
</head>
<body>

  {# --- Página 1: anotaciones + objetivo diario --- #}
  <section class="notes-page">
    <h1 class="notes-title">Anotaciones Importantes</h1>

    <ul class="notes-list">
      {% for nota in anotaciones %}
      <li>{{ nota }}</li>
      {% endfor %}
    </ul>

    <div class="targets">
      <h2>Tu objetivo diario</h2>
      <div class="tiles">
        {% for t in target_tiles %}
        <div class="tile" style="background: {{ t.soft }}; color: {{ t.color }}">
          <span class="val">{{ t.value }}</span>
          <span class="lbl">{{ t.label }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# --- Una página por fase (15 días = 1 rejilla; 30 días = 2) --- #}
  {% for section in sections %}
  <section class="phase-page">
    <div class="banner">
      {% if branding.tenant_name %}<span class="kicker">{{ branding.tenant_name }}</span>{% endif %}
      <h1>Plan Nutricional</h1>
    </div>

    <p class="intro">{{ section.intro }}</p>

    <table class="grid">
      <thead>
        <tr>
          <th class="corner"></th>
          {% for day in section.days %}<th class="day">{{ day }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {# Cada comida son DOS filas: la de arriba lleva la comida (pegada al techo de
           la celda) y la de abajo los extras y los macros (pegados al suelo). Así los
           macros quedan alineados en las siete columnas POR CONSTRUCCIÓN —son su propia
           fila— y el hueco cae donde tiene que caer: entre el final de la comida y el
           "Ensalada libre". Dentro de UNA celda no se puede: en WeasyPrint no funcionan
           ni el flex con height:100%, ni position:absolute, ni fijarle la altura a la
           fila (se probaron los cuatro). Las dos filas se leen como una sola tarjeta
           porque `border-spacing` no deja hueco vertical: el aire entre comidas lo pone
           un borde blanco. #}
        {% for row in section.rows %}
        {% set stripe = 'alt' if loop.index0 % 2 else '' %}
        <tr class="meal {{ stripe }}">
          <th class="slot" rowspan="2">{{ row.label }}</th>
          {% for cell in row.cells %}
          <td class="{% if cell.free_meal %}free-meal{% endif %}">
            {% if cell.free_meal %}
            <span class="free-meal-title">COMIDA LIBRE</span>
            {% endif %}
            {% for p in cell.portions %}<span class="portion">{{ p.text }}</span>{% endfor %}
          </td>
          {% endfor %}
        </tr>
        <tr class="foot {{ stripe }}">
          {% for cell in row.cells %}
          <td class="{% if cell.free_meal %}free-meal{% endif %}">
            {% if cell.free_meal %}
            <span class="free-meal-note">Come lo que quieras</span>
            {% endif %}
            {% for e in cell.extras %}<span class="extra">{{ e }}</span>{% endfor %}
            {% if cell.macro_line %}
            <span class="macros">
              <span class="m-kcal">{{ cell.kcal | round | int }} kcal</span>
              <span class="m-pcg">P {{ cell.protein_g | round | int }} · C {{ cell.carb_g | round | int }} · G {{ cell.fat_g | round | int }}</span>
            </span>
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
        <tr class="day-totals">
          <th class="slot">Totales día</th>
          {% for dt in section.day_totals %}
          <td>
            <span class="total-kcal">{{ dt.kcal }} kcal</span>
            <span class="total-macros">P {{ dt.protein_g }} · C {{ dt.carb_g }} · G {{ dt.fat_g }}</span>
          </td>
          {% endfor %}
        </tr>
      </tbody>
    </table>

    <div class="brandmark">
      {% if logo_data_uri %}<img class="logo" src="{{ logo_data_uri }}" alt="">{% endif %}
      {% if branding.tenant_name %}<span class="name">{{ branding.tenant_name }}</span>{% endif %}
      {% if branding.handle %}<span class="handle">@{{ branding.handle.lstrip('@') }}</span>{% endif %}
    </div>
  </section>
  {% endfor %}

</body>
</html>
