ENV=local                      # local | prod
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Supabase (Postgres) ---------------------------------------------------
# La app usa el TRANSACTION POOLER (puerto 6543). create_engine() apaga el caché
# de prepared statements de asyncpg porque pgbouncer en modo transaction los
# rompe (`prepared statement "__asyncpg_stmt_1__" does not exist`).
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Alembic NO puede ir por el transaction pooler (necesita sesión): para correr
# migraciones a mano usa la conexión directa (5432) en esta misma variable.
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Supabase local (`supabase start`):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
#
# Tras la primera migración manual puedes acelerar el arranque:
#   RUN_MIGRATIONS_ON_START=false

BASE_URL=http://127.0.0.1:8000   # URL pública: la usan los enlaces de correo

# --- Sesión ----------------------------------------------------------------
# Firma la cookie de sesión Y los tokens de verificación/recuperación. En prod
# NO puede quedarse en el valor por defecto.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Login social ----------------------------------------------------------
# Vacíos = solo correo y contraseña. En móvil el ID token lo produce el plugin
# nativo y se postea a /auth/oauth/{google|apple}: Google bloquea su login
# dentro de un WebView plano.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=          # requiere el extra: uv sync --extra apple

# --- Correo ----------------------------------------------------------------
# Vacío = adaptador de consola (el correo se ve en el log). Con SMTP_HOST se
# envía de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NutriPlan <no-reply@nutriplan.app>

# --- IA ---------------------------------------------------------------------
# Modelo de pesos abiertos vía API compatible con OpenAI. Groq da cuota gratis
# sin tarjeta y `gpt-oss` (Apache 2.0) es el único que garantiza JSON Schema
# estricto, que es justo lo que exige el puerto LLMClient.
#   Consigue la clave en https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_GENERATE=openai/gpt-oss-120b
LLM_MODEL_INGEST=openai/gpt-oss-20b

# Reserva: entra si el primario falla o agota la cuota (~1.000 req/día en Groq).
# Si tampoco está, la generación cae al selector determinista y sale igual.
#   LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Claude es opcional: uv sync --extra anthropic
ANTHROPIC_API_KEY=
REDIS_URL=                     # vacío en local
OBJECT_STORAGE_URL=            # vacío en local (usa filesystem)
LOG_LEVEL=INFO

# --- Super usuario ---------------------------------------------------------
# No hay registro público: el super_user crea a los entrenadores desde /admin.
# Si ADMIN_EMAIL y ADMIN_PASSWORD están seteados y la cuenta no existe, se
# siembra al arrancar (mín. 8 caracteres de clave).
ADMIN_EMAIL=
ADMIN_PASSWORD=
