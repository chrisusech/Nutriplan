ENV=local                      # local | prod
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Supabase (Postgres) ---------------------------------------------------
# La app usa el TRANSACTION POOLER (puerto 6543). create_engine() apaga el caché
# de prepared statements de asyncpg porque pgbouncer en modo transaction los
# rompe (`prepared statement "__asyncpg_stmt_1__" does not exist`).
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Alembic NO puede ir por el transaction pooler (necesita sesión): para correr
# migraciones a mano usa la conexión directa (5432) en esta misma variable.
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Tras la primera migración manual puedes acelerar el arranque:
#   RUN_MIGRATIONS_ON_START=false
RUN_MIGRATIONS_ON_START=true

BASE_URL=http://127.0.0.1:8000   # URL pública: la usan los enlaces de correo
# Dominios que la app acepta servir, separados por comas. Vacío = sin comprobar
# (solo local): sin esto, un Host falsificado envenena los enlaces de correo.
ALLOWED_HOSTS=

# --- Beta cerrada -----------------------------------------------------------
# Vacío = cualquiera puede registrarse (local). En prod pon un código y
# compártelo solo con los testers; aparece en /registro.
BETA_INVITE_CODE=

# --- Sesión ----------------------------------------------------------------
# Firma la cookie de sesión Y los tokens de verificación/recuperación. En prod
# NO puede quedarse en el valor por defecto.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Login social ----------------------------------------------------------
# Vacíos = solo correo y contraseña. En móvil el ID token lo produce el plugin
# nativo y se postea a /auth/oauth/{google|apple}: Google bloquea su login
# dentro de un WebView plano.
GOOGLE_CLIENT_ID=          # el Client ID *web*: es el `aud` de los tokens que
                           # manda el plugin nativo (ver mobile/README.md)
APPLE_CLIENT_ID=app.nutriplan  # el `aud` nativo es el bundle; extra `apple`

# --- Correo ----------------------------------------------------------------
# Vacío = adaptador de consola. En local el correo (con el enlace) sale por
# stderr; el log estructurado solo anota el asunto, sin token. Con SMTP_HOST
# se envía de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NutriPlan <no-reply@nutriplan.co>
# En Fly el release_command usa la URL directa (:5432), no el pooler:
#   DIRECT_DATABASE_URL=postgresql+asyncpg://…@db.…supabase.co:5432/postgres

# --- IA ---------------------------------------------------------------------
# Producto: el motor arma la semana (gramos/macros). La IA solo escribe
# recetas al abrir un día. LLM_SELECT_FOODS=true es flag de prueba.
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=…   # AI Studio → Get API key
#   LLM_MODEL_GENERATE=gemini-3.6-flash
LLM_SELECT_FOODS=false
LLM_REFINE_NAMES=false
LLM_EAGER_RECIPES=false
LLM_SELECT_MAX_RETRIES=2
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL_GENERATE=gemini-3.6-flash

# Reserva opcional (apagada en lean). Si se activa, no mandes selección aquí:
# el prompt de semana suele superar el TPM gratis de Groq.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Claude es opcional: uv sync --extra anthropic
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO

# --- Super usuario ---------------------------------------------------------
# Si ADMIN_EMAIL y ADMIN_PASSWORD están seteados y la cuenta no existe, se
# siembra al arrancar (mín. 8 caracteres de clave).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tick del domingo (prod lo enciende ENV=prod). Secret para POST /internal/tick.
AUTO_WEEK_TICK=false
INTERNAL_TICK_SECRET=
